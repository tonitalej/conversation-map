{
  "name": "conversation-map",
  "version": "1.0.0",
  "private": true,
  "description": "Turn a conversation transcript into a validated, evidence-linked, interactive knowledge map.",
  "license": "MIT",
  "author": "Tony (https://github.com/tonitalej)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonitalej/conversation-map.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:e2e": "npm run build && playwright test",
    "examples": "node scripts/build-examples.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
